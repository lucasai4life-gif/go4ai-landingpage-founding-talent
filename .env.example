# Máy chủ chỉ lắng nghe localhost
HOST=127.0.0.1
PORT=8787

# Mùa tuyển chọn hiện hành
SEASON_ID=ftc-2026
# Hạn đăng ký (UTC). 23:59 30/11/2026 GMT+7 = 16:59 30/11/2026 UTC
REGISTRATION_CLOSES_AT=2026-11-30T16:59:59Z

# Telegram: lấy token từ @BotFather, chat id bằng `npm run telegram:chat-id`
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Token đọc danh sách lead qua /api/admin/* (đặt chuỗi dài, ngẫu nhiên)
ADMIN_TOKEN=

# Muối để băm IP (không lưu IP gốc)
IP_HASH_SALT=change-me
